        Button { showEmailLogin = true } label: {
            HStack(spacing: 10) {
                Image(systemName: "envelope.fill")
                    .font(.system(size: 16, weight: .medium))

                Text("Continue with Email")
                    .font(.system(size: 15, weight: .semibold))
            }
            .foregroundStyle(.black)
            .frame(maxWidth: .infinity)
            .frame(height: 48)
            .background(Color.white)
            .clipShape(RoundedRectangle(cornerRadius: 14, style: .continuous))
        }
        .disabled(viewModel.isLoading)
        .acPressable(scale: 0.98)
        .accessibilityLabel("Continue with Email")
    }

    #if DEBUG
    private var debugButton: some View {
        Button { viewModel.continueInDebug() } label: {
            Text("Debug: Mock Sign In")
                .font(.system(size: 11, weight: .medium))
                .foregroundStyle(Color.acMutedForeground.opacity(0.5))
        }
        .padding(.top, 6)
    }
    #endif

    // MARK: - Error Banner

    private func errorBanner(_ message: String) -> some View {
        HStack(spacing: 12) {
            Image(systemName: "exclamationmark.triangle.fill")
                .font(.system(size: 16))
                .foregroundStyle(Color.acDestructive)

            Text(message)
                .font(.system(size: 13, weight: .medium))
                .foregroundStyle(Color.acGlassTextPrimary)
                .multilineTextAlignment(.leading)

            Spacer()

            Button {
                withAnimation(ACSpring.quick) {
                    viewModel.errorMessage = nil
                }
            } label: {
                Image(systemName: "xmark.circle.fill")
                    .font(.system(size: 18))
                    .foregroundStyle(Color.acGlassTextSecondary)
            }
        }
        .padding(14)
        .acLiquidGlass(tint: Color.acDestructive.opacity(0.15), cornerRadius: ACRadius.glassSmall)
        .overlay(
            RoundedRectangle(cornerRadius: ACRadius.glassSmall, style: .continuous)
                .strokeBorder(Color.acDestructive.opacity(0.3), lineWidth: 1)
        )
        .transition(.asymmetric(
            insertion: .scale(scale: 0.95).combined(with: .opacity),
            removal: .scale(scale: 0.95).combined(with: .opacity)
        ))
    }

    // MARK: - Legal Section

    private var legalSection: some View {
        VStack(spacing: 8) {
            Text("By continuing, you agree to our")
                .font(.system(size: 11, weight: .regular))
                .foregroundStyle(Color.acMutedForeground.opacity(0.6))

            HStack(spacing: 12) {
                Button { /* Open terms */ } label: {
                    Text("Terms of Service")
                        .font(.system(size: 11, weight: .medium))
                        .foregroundStyle(Color.acGlassTextAccent.opacity(0.8))
                }

                Text("•")
                    .foregroundStyle(Color.acMutedForeground.opacity(0.3))

                Button { /* Open privacy */ } label: {
                    Text("Privacy Policy")
                        .font(.system(size: 11, weight: .medium))
                        .foregroundStyle(Color.acGlassTextAccent.opacity(0.8))
                }
            }
        }
        .opacity(showLegal ? 1 : 0)
        .offset(y: showLegal ? 0 : 10)
    }
}

// MARK: - ViewModel

@MainActor
@Observable
final class SignInViewModel {
    enum AuthMethodType {
        case apple, google, email
    }

    var isLoading: Bool = false
    var loadingMethod: AuthMethodType? = nil
    var errorMessage: String?

    fileprivate let authClient: AuthClient

    init(authClient: AuthClient) {
        self.authClient = authClient
    }

    func signInWithApple() async {
        isLoading = true
        loadingMethod = .apple
        errorMessage = nil

        defer {
            isLoading = false
            loadingMethod = nil
        }

        do {
            _ = try await authClient.signInWithApple()
            AppLogger.info("Apple sign in successful", category: AppLogger.ui)
        } catch {
            let appError = AppError.from(error)
            errorMessage = appError.userMessage
            AppLogger.error("Apple sign in failed: \(error)", category: AppLogger.ui)
            autoDismissError(appError.userMessage)
        }
    }

    func signInWithGoogle() async {
        isLoading = true
        loadingMethod = .google
        errorMessage = nil

        defer {
            isLoading = false
            loadingMethod = nil
        }

        do {
            _ = try await authClient.signInWithGoogle()
            AppLogger.info("Google sign in successful", category: AppLogger.ui)
        } catch {
            let appError = AppError.from(error)
            errorMessage = appError.userMessage
            AppLogger.error("Google sign in failed: \(error)", category: AppLogger.ui)
            autoDismissError(appError.userMessage)
        }
    }

    private func autoDismissError(_ message: String) {
        Task {
            try? await Task.sleep(nanoseconds: 5_000_000_000)
            if self.errorMessage == message {
                self.errorMessage = nil
            }
        }
    }

    #if DEBUG
    func continueInDebug() {
        Task {
            AppLogger.info("Debug sign-in started", category: AppLogger.auth)
            if type(of: authClient) == Auth.MockAuthClient.self {
                do {
                    let user = try await authClient.signInWithApple()
                    AppLogger.info("Debug sign-in successful: \(user.id)", category: AppLogger.auth)
                } catch {
                    AppLogger.error("Debug sign-in failed: \(error)", category: AppLogger.auth)
                }
            } else {
                errorMessage = "Debug mode not enabled. Set AUTH_BYPASS=1 in scheme."
            }
        }
    }
    #endif
}

// MARK: - SceneKit Globe View

/// A UIViewRepresentable wrapper for SCNView to display a 3D orrery with orbit tap support
@available(iOS 17.0, *)
private struct SceneKitGlobeView: UIViewRepresentable {
    let scene: SCNScene
    var onOrbitTap: ((String) -> Void)?

    init(scene: SCNScene, onOrbitTap: ((String) -> Void)? = nil) {
        self.scene = scene
        self.onOrbitTap = onOrbitTap
    }

    func makeCoordinator() -> Coordinator {
        Coordinator(onOrbitTap: onOrbitTap)
    }

    func makeUIView(context: Context) -> SCNView {
        let scnView = SCNView()
        scnView.scene = scene
        scnView.backgroundColor = .clear
        scnView.allowsCameraControl = false
        scnView.autoenablesDefaultLighting = false
        scnView.antialiasingMode = .multisampling4X
        scnView.isPlaying = true

        // Add tap gesture
        let tapGesture = UITapGestureRecognizer(target: context.coordinator, action: #selector(Coordinator.handleTap(_:)))
        scnView.addGestureRecognizer(tapGesture)
        context.coordinator.scnView = scnView

        return scnView
    }

    func updateUIView(_ uiView: SCNView, context: Context) {
        context.coordinator.onOrbitTap = onOrbitTap
    }

    class Coordinator: NSObject {
        var onOrbitTap: ((String) -> Void)?
        weak var scnView: SCNView?

        // Orbit radii for distance-based detection (matching setupGlobeScene)
        let orbitData: [(String, CGFloat)] = [
            ("moon", 0.55),
            ("venus", 0.72),
            ("mars", 0.90),
            ("jupiter", 1.10),
            ("saturn", 1.32),
            ("neptune", 1.56),
        ]

        init(onOrbitTap: ((String) -> Void)?) {
            self.onOrbitTap = onOrbitTap
        }

        @objc func handleTap(_ gesture: UITapGestureRecognizer) {
            guard let scnView = scnView else { return }
            let location = gesture.location(in: scnView)

            // Get the center of the view (where sun is)
            let centerX = scnView.bounds.width / 2
            let centerY = scnView.bounds.height / 2

            // Calculate distance from center in screen coordinates
            let tapDistanceFromCenter = hypot(location.x - centerX, location.y - centerY)

            // Convert screen distance to scene units (approximate based on orthographic scale)
            // The camera orthographicScale is 2.0 and view shows ~4.0 units across
            let viewSize = min(scnView.bounds.width, scnView.bounds.height)
            let sceneUnitsPerPoint = 4.0 / viewSize

            let tapRadiusInScene = tapDistanceFromCenter * sceneUnitsPerPoint

            // Find which orbit is closest to the tap
            var closestOrbit: String? = nil
            var closestDistance: CGFloat = .infinity

            for (planetName, orbitRadius) in orbitData {
                let distance = abs(tapRadiusInScene - orbitRadius)
                // Allow 0.12 scene units tolerance (roughly 25-30 points)
                if distance < 0.12 && distance < closestDistance {
                    closestDistance = distance
                    closestOrbit = planetName
                }
            }

            if let orbit = closestOrbit {
                onOrbitTap?(orbit)
            }
        }
    }
}

