    // MARK: - Feature Preview Pills (Marquee)

    private let featurePillsData: [(icon: String, label: String, color: Color)] = [
        ("globe.americas.fill", "Astro Lines", .acPlanetSun),
        ("binoculars.fill", "Scout Cities", .acPlanetJupiter),
        ("person.2.fill", "Duo Mode", .acPlanetVenus),
        ("sparkles", "AI Insights", .white),
        ("map.fill", "Relocation", .acPlanetMars),
        ("chart.xyaxis.line", "Natal Chart", .acPlanetMoon),
    ]

    private var featurePreviewSection: some View {
        let spacing: CGFloat = 12

        // Use TimelineView for truly seamless infinite scrolling
        return TimelineView(.animation) { timeline in
            let now = timeline.date.timeIntervalSinceReferenceDate
            // Complete loop every 25 seconds
            let totalWidth: CGFloat = 942 // 6 pills × 145 + 6 × 12 spacing
            let progress = now.truncatingRemainder(dividingBy: 25) / 25
            let offset = -totalWidth * progress

            HStack(spacing: spacing) {
                // Double the pills for seamless looping
                ForEach(0..<2, id: \.self) { setIndex in
                    ForEach(featurePillsData.indices, id: \.self) { index in
                        let pill = featurePillsData[index]
                        featurePill(icon: pill.icon, label: pill.label, color: pill.color)
                    }
                }
            }
            .offset(x: offset)
        }
        .frame(height: 44)
        // No background - fully transparent to show orbits behind
    }

    private func featurePill(icon: String, label: String, color: Color) -> some View {
        HStack(spacing: 8) {
            Image(systemName: icon)
                .font(.system(size: 14, weight: .semibold))
                .foregroundStyle(color)

            Text(label)
                .font(.system(size: 13, weight: .semibold))
                .foregroundStyle(Color.white)
                .fixedSize(horizontal: true, vertical: false)
        }
        .padding(.horizontal, 16)
        .padding(.vertical, 10)
        .background(
            Capsule()
                .fill(Color.black.opacity(0.5))
        )
        .overlay(
            Capsule()
                .strokeBorder(Color.white.opacity(0.25), lineWidth: 0.5)
        )
    }

    // MARK: - Orrery Hero View

    private func orreryHeroView(size: CGSize) -> some View {
        // Make orrery big - bleed past screen edges
        let orrerySize = size.width * 1.4

        return ZStack(alignment: .center) {
            // Ambient base glow
            Circle()
                .fill(
                    RadialGradient(
                        colors: [
                            Color.acAmber500.opacity(0.10),
                            Color.acCosmicPurple.opacity(0.05),
                            Color.clear
                        ],
                        center: .center,
                        startRadius: 0,
                        endRadius: orrerySize * 0.45
                    )
                )
                .frame(width: orrerySize, height: orrerySize)

            // 3D SceneKit orrery with orbit glow on tap
            if let scene = globeScene {
                SceneKitGlobeView(scene: scene, onOrbitTap: handleOrbitTap)
                    .frame(width: orrerySize, height: orrerySize)
            } else {
                // Loading placeholder
                Circle()
                    .stroke(Color.white.opacity(0.1), lineWidth: 1)
                    .frame(width: orrerySize * 0.6, height: orrerySize * 0.6)
            }
        }
        .frame(width: orrerySize, height: orrerySize)
    }

    /// Handle orbit tap - glow the orbit ring in SceneKit
    private func handleOrbitTap(_ planetName: String) {
        guard let scene = globeScene,
              let ringNode = scene.rootNode.childNode(withName: "\(planetName)_ring", recursively: false),
              let torus = ringNode.geometry as? SCNTorus else { return }

        // Get the glow color for this planet's orbit
        let glowColor = orbitGlowColor(for: planetName)

        // Store original material
        let originalMaterial = torus.materials.first?.copy() as? SCNMaterial

        // Create intensely glowing material - brighter emission for more vibrant glow
        let glowMaterial = SCNMaterial()
        glowMaterial.diffuse.contents = glowColor.withAlphaComponent(0.9)
        glowMaterial.emission.contents = glowColor
        glowMaterial.emission.intensity = 2.0 // Boost emission for brighter glow
        glowMaterial.lightingModel = .constant
        glowMaterial.blendMode = .add // Additive blending for ethereal glow effect

        // Make the ring thicker when glowing
        let originalPipeRadius = torus.pipeRadius

        // Animate to glow state
        SCNTransaction.begin()
        SCNTransaction.animationDuration = 0.15
        torus.materials = [glowMaterial]
        torus.pipeRadius = originalPipeRadius * 3.0
        SCNTransaction.commit()

        // Fade back after delay
        DispatchQueue.main.asyncAfter(deadline: .now() + 1.0) {
            SCNTransaction.begin()
            SCNTransaction.animationDuration = 0.5
            if let original = originalMaterial {
                torus.materials = [original]
            }
            torus.pipeRadius = originalPipeRadius
            SCNTransaction.commit()
        }
    }

    /// Get glow color for each planet's orbit - matching web hero section
    /// Web uses: purple (#9370DB), cornflower blue (#6495ED), pink (#FFB6C1) alternating
    private func orbitGlowColor(for planet: String) -> UIColor {
        // Amethyst purple - more vibrant: rgba(147, 112, 219)
        let purple = UIColor(red: 147/255, green: 112/255, blue: 219/255, alpha: 1.0)
        // Cornflower blue - vibrant: rgba(100, 149, 237)
        let blue = UIColor(red: 100/255, green: 149/255, blue: 237/255, alpha: 1.0)
        // Light pink - soft: rgba(255, 182, 193)
        let pink = UIColor(red: 255/255, green: 182/255, blue: 193/255, alpha: 1.0)

        // Alternating pattern matching web CSS nth-child rules
        switch planet {
        case "moon": return purple    // Orbit 1 (default) - purple
        case "venus": return blue     // Orbit 2 - cornflower blue
        case "mars": return purple    // Orbit 3 - purple
        case "jupiter": return pink   // Orbit 4 - pink
        case "saturn": return purple  // Orbit 5 - purple
        case "neptune": return blue   // Orbit 6 - cornflower blue
        default: return purple
        }
    }

