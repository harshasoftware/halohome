import SwiftUI
import MapKit
import SceneKit
import AuthenticationServices
import DesignSystem
import Auth
import Core

/// Premium sign-in screen featuring a rotating 3D globe background
/// with iOS 26 Liquid Glass UI overlays for an immersive astrocartography preview
@MainActor
@available(iOS 17.0, *)
struct SignInView: View {

    @State private var viewModel: SignInViewModel
    @State private var showEmailLogin = false
    @State private var showEmailSignUp = false
    @State private var showForgotPassword = false

    // Animation states for staggered entrance
    @State private var showGlobe = false
    @State private var showOverlay = false
    @State private var showTitle = false
    @State private var showAuthCard = false
    @State private var showFeaturePills = false
    @State private var showLegal = false

    // SceneKit globe scene (created once)
    @State private var globeScene: SCNScene?

    // Marquee animation
    @State private var marqueeOffset: CGFloat = 0

    // Rotating headlines & subheadlines (matching web landing page)
    @State private var currentTaglineIndex: Int = 0
    private let headlines: [String] = [
        "Navigate Your Cosmic Destiny",
        "Find Where You Belong",
        "Map Your Life Path",
        "Discover Your Power Places"
    ]
    private let subheadlines: [String] = [
        "Discover where you belong in the universe.",
        "Map your planetary lines for love and career.",
        "Find your power places with AI astrology.",
        "Real-time astrocartography for your life path."
    ]

    init(authClient: AuthClient) {
        self._viewModel = State(initialValue: SignInViewModel(authClient: authClient))
    }

    var body: some View {
        NavigationStack {
            GeometryReader { geometry in
                ZStack {
                    // Dark cosmic background
                    globeBackground
                        .ignoresSafeArea()

                    // Main layout
                    VStack(spacing: 0) {
                        // Feature pills at top
                        featurePreviewSection
                            .padding(.top, 50)
                            .padding(.bottom, 12)

                        // Large orrery with title centered inside
                        GeometryReader { orreryGeo in
                            let orrerySize = geometry.size.width * 1.4

                            ZStack {
                                // Orrery - planetary system (centered, bleeds edges)
                                orreryHeroView(size: geometry.size)
                                    .position(x: orreryGeo.size.width / 2, y: orreryGeo.size.height / 2 - 20)

                                // Title centered in the middle of the orbits
                                VStack(spacing: 12) {
                                    // Rotating headline (larger, like web hero)
                                    Text(headlines[currentTaglineIndex])
                                        .font(.system(size: 28, weight: .bold))
                                        .foregroundStyle(Color.acForeground)
                                        .multilineTextAlignment(.center)
                                        .shadow(color: .black.opacity(0.9), radius: 15)
                                        .shadow(color: .black.opacity(0.6), radius: 5)
                                        .id("headline-\(currentTaglineIndex)")
                                        .transition(.opacity.combined(with: .scale(scale: 0.95)))

                                    // Rotating subheadline
                                    Text(subheadlines[currentTaglineIndex])
                                        .font(.system(size: 15, weight: .medium))
                                        .foregroundStyle(Color.acMutedForeground)
                                        .multilineTextAlignment(.center)
                                        .tracking(0.3)
                                        .shadow(color: .black.opacity(0.8), radius: 10)
                                        .id("subheadline-\(currentTaglineIndex)")
                                        .transition(.opacity.combined(with: .scale(scale: 0.95)))
                                }
                                .animation(.easeInOut(duration: 0.5), value: currentTaglineIndex)
                                .position(x: orreryGeo.size.width / 2, y: orreryGeo.size.height / 2 - 20)
                            }
                        }
                        .frame(height: geometry.size.height * 0.42)
                        .clipped()

                        Spacer(minLength: 8)

                        // Bottom: Auth card
                        authCard
                            .padding(.horizontal, 20)
                            .padding(.bottom, 6)

                        // Legal footer
                        legalSection
                            .padding(.bottom, 16)
                            .safeAreaPadding(.bottom)
                    }
                }
            }
            .onAppear {
                startEntranceAnimation()
                setupGlobeScene()
            }
            .sheet(isPresented: $showEmailLogin) {
                EmailLoginView(
                    authClient: viewModel.authClient,
                    onSuccess: { showEmailLogin = false },
                    onSwitchToSignUp: {
                        showEmailLogin = false
                        Task { @MainActor in
                            try? await Task.sleep(nanoseconds: 300_000_000)
                            showEmailSignUp = true
                        }
                    },
                    onForgotPassword: {
                        showEmailLogin = false
                        Task { @MainActor in
                            try? await Task.sleep(nanoseconds: 300_000_000)
                            showForgotPassword = true
                        }
                    }
                )
                .preferredColorScheme(.dark)
            }
            .sheet(isPresented: $showEmailSignUp) {
                EmailSignUpView(
                    authClient: viewModel.authClient,
                    onSuccess: { showEmailSignUp = false },
                    onSwitchToLogin: {
                        showEmailSignUp = false
                        Task { @MainActor in
                            try? await Task.sleep(nanoseconds: 300_000_000)
                            showEmailLogin = true
                        }
                    }
                )
                .preferredColorScheme(.dark)
            }
            .sheet(isPresented: $showForgotPassword) {
                ForgotPasswordView(
                    authClient: viewModel.authClient,
                    onBackToLogin: {
                        showForgotPassword = false
                        Task { @MainActor in
                            try? await Task.sleep(nanoseconds: 300_000_000)
                            showEmailLogin = true
                        }
                    }
                )
                .preferredColorScheme(.dark)
            }
        }
        .preferredColorScheme(.dark)
    }

    // MARK: - Entrance Animation

    private func startEntranceAnimation() {
        // Set all to true immediately to debug rendering
        showGlobe = true
        showOverlay = true
        showTitle = true
        showFeaturePills = true
        showAuthCard = true
        showLegal = true

        // Start rotating taglines
        startTaglineRotation()
    }

    private func startTaglineRotation() {
        Task {
            while true {
                try? await Task.sleep(nanoseconds: 4_000_000_000) // 4 seconds (matching web timing)
                await MainActor.run {
                    withAnimation(.easeInOut(duration: 0.5)) {
                        currentTaglineIndex = (currentTaglineIndex + 1) % headlines.count
                    }
                }
            }
        }
    }

    private func setupGlobeScene() {
        guard globeScene == nil else { return }

        let scene = SCNScene()
        scene.background.contents = UIColor.clear

        // Planet data - NO SUN, orbits sized so title fits in center
        // Innermost orbit at 0.55 leaves room for title in center
        // (name, orbitRadius, orbitDuration, planetSize, hasRing, orbitColor)
        let planets: [(String, Float, Double, Float, Bool, UIColor)] = [
            ("moon", 0.55, 10, 0.050, false, UIColor(red: 0.8, green: 0.8, blue: 0.9, alpha: 1.0)),
            ("venus", 0.72, 14, 0.060, false, UIColor(red: 1.0, green: 0.7, blue: 0.3, alpha: 1.0)),
            ("mars", 0.90, 18, 0.055, false, UIColor(red: 1.0, green: 0.3, blue: 0.4, alpha: 1.0)),
            ("jupiter", 1.10, 24, 0.085, false, UIColor(red: 1.0, green: 0.7, blue: 0.5, alpha: 1.0)),
            ("saturn", 1.32, 32, 0.070, true, UIColor(red: 1.0, green: 0.8, blue: 0.4, alpha: 1.0)),
            ("neptune", 1.56, 42, 0.060, false, UIColor(red: 0.4, green: 0.7, blue: 1.0, alpha: 1.0)),
        ]

        // Create orbital rings FIRST (rendered behind planets)
        for (name, orbitRadius, _, _, _, _) in planets {
            let ring = SCNTorus(ringRadius: CGFloat(orbitRadius), pipeRadius: 0.005)
            let ringMaterial = SCNMaterial()
            ringMaterial.diffuse.contents = UIColor.white.withAlphaComponent(0.18)
            ringMaterial.emission.contents = UIColor.white.withAlphaComponent(0.1)
            ringMaterial.lightingModel = .constant
            ring.materials = [ringMaterial]
            let ringNode = SCNNode(geometry: ring)
            ringNode.name = "\(name)_ring" // Name for glow targeting
            ringNode.renderingOrder = 0 // Render first (behind)
            scene.rootNode.addChildNode(ringNode)
        }

        // Create planets AFTER orbits (rendered on top)
        for (name, orbitRadius, orbitDuration, planetSize, hasRing, _) in planets {
            let planetNode = createStyledPlanet(name: name, radius: planetSize, hasRing: hasRing)
            planetNode.renderingOrder = 10 // Render after orbits (on top)

            // Create orbit pivot for animation
            let orbitNode = SCNNode()
            orbitNode.name = "\(name)_orbit"
            // Position planet slightly ABOVE the orbit plane for z-ordering
            planetNode.position = SCNVector3(orbitRadius, 0.02, 0)
            orbitNode.addChildNode(planetNode)
            scene.rootNode.addChildNode(orbitNode)

            // Orbit animation
            let rotation = CABasicAnimation(keyPath: "rotation")
            rotation.toValue = NSValue(scnVector4: SCNVector4(0, 1, 0, Float.pi * 2))
            rotation.duration = orbitDuration
            rotation.repeatCount = .infinity
            orbitNode.addAnimation(rotation, forKey: "orbit")

            // Self rotation
            let selfRotation = CABasicAnimation(keyPath: "rotation")
            selfRotation.toValue = NSValue(scnVector4: SCNVector4(0, 1, 0, Float.pi * 2))
            selfRotation.duration = 4
            selfRotation.repeatCount = .infinity
            planetNode.addAnimation(selfRotation, forKey: "spin")
        }

        // Ambient light
        let ambientLight = SCNNode()
        ambientLight.light = SCNLight()
        ambientLight.light?.type = .ambient
        ambientLight.light?.color = UIColor(white: 0.6, alpha: 1.0)
        scene.rootNode.addChildNode(ambientLight)

        // Camera - straight top-down view like web hero section
        let cameraNode = SCNNode()
        cameraNode.camera = SCNCamera()
        cameraNode.camera?.usesOrthographicProjection = true
        cameraNode.camera?.orthographicScale = 2.0
        cameraNode.position = SCNVector3(0, 5, 0)
        cameraNode.eulerAngles = SCNVector3(-Float.pi / 2, 0, 0)
        scene.rootNode.addChildNode(cameraNode)

        globeScene = scene
    }

    /// Creates a styled planet node using the 2D PNG images from web assets
    /// Uses billboard planes so planets always face the camera (like web version)
    private func createStyledPlanet(name: String, radius: Float, hasRing: Bool) -> SCNNode {
        let planetNode = SCNNode()
        planetNode.name = name

        // Try to load the planet image from assets
        let imageName = "planet-\(name)"
        let planetSize = CGFloat(radius * 2.2) // Scale up for visibility

        if let planetImage = UIImage(named: imageName) {
            // Use SCNPlane with the 2D image texture
            let plane = SCNPlane(width: planetSize, height: planetSize)
            let material = SCNMaterial()
            material.diffuse.contents = planetImage
            material.isDoubleSided = true
            material.lightingModel = .constant // No lighting, show image as-is
            material.writesToDepthBuffer = true
            material.readsFromDepthBuffer = true
            plane.materials = [material]

            let imageNode = SCNNode(geometry: plane)
            // Rotate to face up (since camera looks down)
            imageNode.eulerAngles = SCNVector3(-Float.pi / 2, 0, 0)
            planetNode.addChildNode(imageNode)
        } else {
            // Fallback colored sphere if image not found
            let sphere = SCNSphere(radius: CGFloat(radius))
            sphere.segmentCount = 32
            let material = SCNMaterial()
            material.diffuse.contents = fallbackColor(for: name)
            material.emission.contents = fallbackColor(for: name).withAlphaComponent(0.4)
            material.lightingModel = .constant
            sphere.materials = [material]
            let sphereNode = SCNNode(geometry: sphere)
            planetNode.addChildNode(sphereNode)
        }

        return planetNode
    }

    /// Creates a radial glow image for the sun
    /// Fallback colors for planets if images aren't loaded
    private func fallbackColor(for planet: String) -> UIColor {
        switch planet {
        case "moon": return UIColor(red: 0.7, green: 0.7, blue: 0.72, alpha: 1.0)
        case "venus": return UIColor(red: 0.95, green: 0.65, blue: 0.15, alpha: 1.0)
        case "mars": return UIColor(red: 0.9, green: 0.25, blue: 0.35, alpha: 1.0)
        case "jupiter": return UIColor(red: 0.92, green: 0.65, blue: 0.5, alpha: 1.0)
        case "saturn": return UIColor(red: 0.9, green: 0.72, blue: 0.3, alpha: 1.0)
        case "neptune": return UIColor(red: 0.3, green: 0.6, blue: 0.9, alpha: 1.0)
        default: return UIColor.gray
        }
    }

    // MARK: - Dark Cosmic Background

