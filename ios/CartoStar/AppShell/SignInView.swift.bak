    private var googleLogo: some View {
        let blue = Color(red: 66/255, green: 133/255, blue: 244/255)
        let red = Color(red: 234/255, green: 67/255, blue: 53/255)
        let yellow = Color(red: 251/255, green: 188/255, blue: 5/255)
        let green = Color(red: 52/255, green: 168/255, blue: 83/255)

        return Canvas { context, size in
            let s = min(size.width, size.height)
            let center = CGPoint(x: s / 2, y: s / 2)
            let radius = s * 0.40
            let thickness = s * 0.20

            func arc(start: Double, end: Double) -> Path {
                var p = Path()
                p.addArc(center: center, radius: radius,
                        startAngle: .degrees(start), endAngle: .degrees(end),
                        clockwise: false)
                return p
            }

            context.stroke(arc(start: 215, end: 330), with: .color(red), lineWidth: thickness)
            context.stroke(arc(start: 330, end: 360), with: .color(blue), lineWidth: thickness)
            context.stroke(arc(start: 25, end: 145), with: .color(green), lineWidth: thickness)
            context.stroke(arc(start: 145, end: 215), with: .color(yellow), lineWidth: thickness)

            let barH = thickness
            let barW = s * 0.28
            let barRect = CGRect(x: center.x - barW * 0.08, y: center.y - barH / 2, width: barW, height: barH)
            context.fill(Path(barRect), with: .color(blue))

            let connectorRect = CGRect(x: center.x + barW * 0.7, y: center.y - barH / 2, width: thickness * 0.5, height: barH)
            context.fill(Path(connectorRect), with: .color(blue))
        }
        .aspectRatio(1, contentMode: .fit)
    }

